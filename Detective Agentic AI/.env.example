# ============================================================
# Detective Agentic AI — Environment / Secrets Template
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit your .env file to version control.
# On Streamlit Cloud, add these under Settings → Secrets.
# ============================================================

# Admin portal PIN (3-digit numeric string, e.g. "739")
# Keep this secret — it unlocks the admin panel and payment approvals.
ADMIN_PIN=739

# Gmail sender address used for cold-email outreach
SENDER_EMAIL=ankit@gmail.com

# UPI payment details shown on the billing page
UPI_VPA=your_upi_id@provider
UPI_NAME=Your Name

# Public platform URL shown in cold emails and trial links
PLATFORM_URL=https://your-app.streamlit.app

# Optional: pre-configure the Gmail App Password here.
# It is safer to enter it at runtime in the Admin UI.
# GMAIL_APP_PASSWORD=your_16_char_google_app_password
